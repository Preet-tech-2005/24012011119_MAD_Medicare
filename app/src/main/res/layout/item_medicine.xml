<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="125dp"
    android:layout_marginBottom="14dp"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- Medicine Icon -->
    <TextView
        android:id="@+id/txtMedicineIcon"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:background="#DBEAFE"
        android:gravity="center"
        android:text="💊"
        android:textSize="27sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Medicine Name -->
    <TextView
        android:id="@+id/txtMedicineName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:text="Paracetamol"
        android:textColor="#172554"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtMedicineIcon"
        app:layout_constraintTop_toTopOf="@id/txtMedicineIcon" />

    <!-- Dosage -->
    <TextView
        android:id="@+id/txtDosage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="5dp"
        android:text="500 mg - 1 tablet"
        android:textColor="#64748B"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtMedicineIcon"
        app:layout_constraintTop_toBottomOf="@id/txtMedicineName" />

    <!-- Reminder Time -->
    <TextView
        android:id="@+id/txtTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="6dp"
        android:text="⏰ 08:00 AM"
        android:textColor="#2563EB"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtMedicineIcon"
        app:layout_constraintTop_toBottomOf="@id/txtDosage" />

</androidx.constraintlayout.widget.ConstraintLayout>