<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="125dp"
    android:layout_marginBottom="14dp"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtIcon"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:background="#DBEAFE"
        android:gravity="center"
        android:text="📋"
        android:textSize="27sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtDisease"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:text="Fever"
        android:textColor="#172554"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtIcon"
        app:layout_constraintTop_toTopOf="@id/txtIcon" />

    <TextView
        android:id="@+id/txtDoctor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="5dp"
        android:text="Doctor: Dr. Patel"
        android:textColor="#64748B"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtIcon"
        app:layout_constraintTop_toBottomOf="@id/txtDisease" />

    <TextView
        android:id="@+id/txtDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="5dp"
        android:text="Date: 14/09/2026"
        android:textColor="#2563EB"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtIcon"
        app:layout_constraintTop_toBottomOf="@id/txtDoctor" />

</androidx.constraintlayout.widget.ConstraintLayout>